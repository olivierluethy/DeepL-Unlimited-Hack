{
  "manifest_version": 3,
  "name": "DeepL Pro Unlimited – Long Texts Without Limits",
  "version": "1.0.6",
  "description": "Translate unlimited long texts with DeepL. Automatically split content into blocks, batch translate, and download results.",
  "permissions": ["scripting", "downloads", "storage", "clipboardRead"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon/icon16.png",
      "32": "icon/icon32.png",
      "48": "icon/icon48.png"
    }
  },
  "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "64": "icon/icon96.png",
    "128": "icon/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.deepl.com/*"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": ["*://www.deepl.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "js/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
