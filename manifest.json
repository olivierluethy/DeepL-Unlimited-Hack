{
  "manifest_version": 3,
  "name": "DeepL Pro Unlimited – Long Texts Without Limits",
  "version": "1.1.5",
  "description": "Translate unlimited long texts with DeepL. Automatically split content into blocks, batch translate, and download results.",
  "permissions": ["scripting", "downloads", "storage", "clipboardRead", "cookies", "tabs", "alarms"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon/icon16.png",
      "32": "icon/icon32.png",
      "48": "icon/icon48.png"
    }
  },
  "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "64": "icon/icon96.png",
    "128": "icon/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://www.deepl.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["*://www.deepl.com/*", "https://eu.i.posthog.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "js/*", "fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
