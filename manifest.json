{
  "manifest_version": 3,
  "name": "DeepL Text-Split Übersetzer",
  "version": "1.0",
  "description": "Automatische Textübersetzung in Blöcken mit Download-Funktion.",
  "permissions": ["scripting", "activeTab", "downloads", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon/icon16.png",
      "32": "icon/icon32.png",
      "48": "icon/icon48.png"
    }
  },
  "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "64": "icon/icon96.png",
    "128": "icon/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.deepl.com/*"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": ["*://www.deepl.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
